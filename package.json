{
  "name": "aimforge",
  "version": "2.0.0",
  "description": "Aim-Trainer mit Sens-Assistent: findet deine optimale Mausempfindlichkeit und rechnet sie für deine Spiele um.",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "node build.mjs",
    "app": "npm run build && electron .",
    "icons": "node scripts/make-icons.cjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "dist:win:linux": "npm run build && electron-builder --win -c.win.signAndEditExecutable=false"
  },
  "keywords": [],
  "author": "AimForge",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-static": "^0.460.0",
    "png-to-ico": "^2.1.8",
    "esbuild": "^0.24.0",
    "three": "^0.170.0"
  },
  "productName": "AimForge",
  "private": true,
  "build": {
    "appId": "de.aimforge.app",
    "productName": "AimForge",
    "copyright": "AimForge",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "dist/AimForge.html",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AimForge",
      "artifactName": "AimForge-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "AimForge"
    },
    "portable": {
      "artifactName": "AimForge-${version}-portable.exe"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
